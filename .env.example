# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Corporate Contact Recipient Email: Every message sent through the website routes here.
CONTACT_RECIPIENT_EMAIL="info@asaolihospitality.ie"

# Optional: Custom SMTP Relay Credentials (e.g. Google Workspace, SendGrid, Resend, or Mailgun)
# If not configured, messages are securely processed, logged to server, and forwarded directly.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@asaolihospitality.ie"
